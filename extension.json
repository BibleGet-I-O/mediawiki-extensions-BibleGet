{
	"manifest_version": 2,
	"name": "BibleGet",
	"type": "parserhook",
	"author": "John R. D'Orazio",
	"version": "2.0.0",
	"url": "https://github.com/BibleGet-I-O/mediawiki-extensions-BibleGet/",
	"description": "Fetch Bible quotes from the BibleGet API.",
	"descriptionmsg": "bibleget-desc",
	"license-name": "Apache-2.0",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"platform": {
			"php": ">= 8.1"
		}
	},
	"ExtensionMessagesFiles": {
		"BibleGetMagic": "BibleGet.i18n.magic.php"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\BibleGet\\": "src/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\BibleGet\\Tests\\": "tests/phpunit/"
	},
	"ServiceWiringFiles": [
		"src/ServiceWiring.php"
	],
	"MessagesDirs": {
		"BibleGet": [
			"i18n"
		]
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "BibleGet/resources"
	},
	"ResourceModules": {
		"ext.bibleGet": {
			"packageFiles": [
				"ext.bibleGet.js"
			],
			"styles": [
				"ext.bibleGet.less"
			],
			"messages": [
				"bibleget-popup-close"
			]
		},
		"ext.bibleGet.styles": {
			"styles": [
				"ext.bibleGet.styles.less"
			]
		},
		"ext.bibleGet.notices": {
			"packageFiles": [
				"ext.bibleGet.notices.js"
			],
			"dependencies": [
				"mediawiki.api",
				"user.options"
			]
		}
	},
	"AvailableRights": [
		"bibleget-manage"
	],
	"GroupPermissions": {
		"sysop": {
			"bibleget-manage": true
		}
	},
	"DefaultUserOptions": {
		"bibleget-dismissed": ""
	},
	"RateLimits": {
		"bibleget-fetch": {
			"anon": [ 30, 60 ],
			"ip": [ 30, 60 ],
			"newbie": [ 30, 60 ],
			"user": [ 120, 60 ]
		}
	},
	"TrackingCategories": [
		"bibleget-tracking-category",
		"bibleget-toolong-category"
	],
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\BibleGet\\Hooks"
		},
		"schema": {
			"class": "MediaWiki\\Extension\\BibleGet\\SchemaHooks"
		},
		"parsertest": {
			"class": "MediaWiki\\Extension\\BibleGet\\Tests\\ParserTestHooks"
		},
		"echo": {
			"class": "MediaWiki\\Extension\\BibleGet\\Notifications\\EchoHooks"
		}
	},
	"Hooks": {
		"ParserFirstCallInit": {
			"handler": "main"
		},
		"LoadExtensionSchemaUpdates": {
			"handler": "schema"
		},
		"ParserTestGlobals": {
			"handler": "parsertest"
		},
		"BeforePageDisplay": {
			"handler": "main"
		},
		"GetPreferences": {
			"handler": "main"
		},
		"BeforeCreateEchoEvent": {
			"handler": "echo"
		}
	},
	"config": {
		"BibleGetApiBase": {
			"value": "https://query.bibleget.io/v4/",
			"description": "Base URL of the BibleGet v4 API."
		},
		"BibleGetApiKey": {
			"value": null,
			"description": "Optional site API key sent to the BibleGet API."
		},
		"BibleGetClientKey": {
			"value": "",
			"description": "Bundled client key identifying this extension to the BibleGet API."
		},
		"BibleGetDefaultBibleVersion": {
			"value": "NABRE",
			"description": "Bible version used when a quote does not name one."
		},
		"BibleGetCacheExpiry": {
			"value": 2592000,
			"description": "Seconds a fetched quote is cached."
		},
		"BibleGetMaxQuotesPerPage": {
			"value": 50,
			"description": "Maximum number of Bible quotes rendered on one page."
		},
		"BibleGetMaxVersesPerQuote": {
			"value": 30,
			"description": "Maximum number of verses rendered for one quote."
		}
	}
}
